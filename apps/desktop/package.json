{
  "name": "vvsm-desktop",
  "productName": "VVSM VPN",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder -mwl" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "online.vvsm.desktop",
    "protocols": [{ "name": "VVSM", "schemes": ["vvsm"] }],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
